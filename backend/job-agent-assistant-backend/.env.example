# DeepSeek API Configuration
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_agent
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# HuggingFace Configuration（国内网络推荐设置镜像）
# HF_ENDPOINT=https://hf-mirror.com

# CORS（允许的前端来源，逗号分隔）
CORS_ORIGINS=http://localhost:5173

# HuggingFace 模型缓存目录
# Windows: E:\\Code Tools\\huggingface
# Docker: /app/models/huggingface
HF_HOME=/app/models/huggingface

# HuggingFace 下载镜像（国内网络推荐）
# HF_ENDPOINT=https://hf-mirror.com

# 是否离线模式（Docker 首次启动=0 下载模型，完成后改为 1）
# HF_HUB_OFFLINE=1

# LibreOffice 路径
# Windows: E:\\Code Tools\\LibreOffice\\program\\soffice.exe
# Docker: /usr/bin/soffice
# LIBREOFFICE_PATH=/usr/bin/soffice

# 上传文件目录（默认为相对路径，Docker 中建议保持默认）
# UPLOAD_DIR=uploads/resumes
# KB_UPLOAD_DIR=uploads/knowledge

# Proxy Configuration（如需通过代理下载模型）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
