# =============================================
# DeepSeek API
# =============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# =============================================
# Database
# =============================================
DB_PASSWORD=your_secure_db_password

# =============================================
# JWT
# =============================================
JWT_SECRET_KEY=generate_a_random_64_char_string_here

# =============================================
# HuggingFace（国内服务器建议设置 HF_ENDPOINT）
# =============================================
# HF_ENDPOINT=https://hf-mirror.com

# =============================================
# CORS（生产环境设为实际前端域名，逗号分隔）
# =============================================
# CORS_ORIGINS=http://your-domain.com,https://your-domain.com

# =============================================
# 国内镜像源（不需要 VPN，取消注释即可）
# =============================================
# APT_MIRROR=mirrors.aliyun.com
# PIP_MIRROR=https://mirrors.aliyun.com/pypi/simple/
# NPM_MIRROR=https://registry.npmmirror.com

# =============================================
# WebSocket URL（前端构建时内联到 JS bundle）
# 本地测试: ws://localhost/api/v1
# 生产环境: wss://your-domain.com/api/v1
# =============================================
VITE_WS_BASE_URL=ws://localhost/api/v1

# =============================================
# 应用端口（对外暴露的 Nginx 端口）
# =============================================
# APP_PORT=80
